# Copy to .env. Matches the postgres service in the root docker-compose.yml.
DB_HOST=localhost
DB_PORT=5432
DB_USER=geoplatform
DB_PASSWORD=geoplatform
DB_NAME=geoplatform

# Signs the access tokens. At least 32 characters; generate one with:
#   openssl rand -base64 48
# Use a different secret per environment and never commit the real one.
JWT_SECRET=

# Access token lifetime in seconds (default 900 = 15 minutes)
ACCESS_TOKEN_TTL=900
# Refresh token lifetime in days (default 30)
REFRESH_TOKEN_TTL_DAYS=30
