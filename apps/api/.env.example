# Copy to .env, then run "node ace generate:key" to fill APP_KEY.

# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Database: the postgres service of the root docker-compose.yml.
# DB_PORT must equal POSTGRES_PORT in the root .env.
DB_HOST=localhost
DB_PORT=5432
DB_USER=geoplatform
DB_PASSWORD=geoplatform
DB_DATABASE=geoplatform

# Redis: the redis service of the root docker-compose.yml.
# REDIS_PORT must equal REDIS_PORT in the root .env.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate limiting store: redis (shared by all api instances) or memory
LIMITER_STORE=redis

# File storage: the rustfs service of the root docker-compose.yml.
# The keys, bucket and port must equal RUSTFS_ACCESS_KEY, RUSTFS_SECRET_KEY,
# RUSTFS_BUCKET and RUSTFS_PORT in the root .env.
# For AWS S3, remove S3_ENDPOINT and use real credentials and region.
DRIVE_DISK=s3
AWS_ACCESS_KEY_ID=geoplatform
AWS_SECRET_ACCESS_KEY=geoplatform-secret
AWS_REGION=us-east-1
S3_BUCKET=geoplatform
S3_ENDPOINT=http://127.0.0.1:9000

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:5174
