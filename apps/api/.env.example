# Copy to .env, then run "node ace generate:key" to fill APP_KEY.

# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Database: matches the postgres service in the root docker-compose.yml.
# DB_PORT must equal POSTGRES_PORT in the root .env.
DB_HOST=localhost
DB_PORT=5432
DB_USER=geoplatform
DB_PASSWORD=geoplatform
DB_DATABASE=geoplatform

# Redis (from the root docker-compose.yml). REDIS_PORT must equal REDIS_PORT in the root .env.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate limiting store: redis (shared by all api instances) or memory
LIMITER_STORE=redis

#--------------------------------------------------------------------
# CORS (configure allowed origins for API access)
# Redis (from the root docker-compose.yml). REDIS_PORT must equal REDIS_PORT in the root .env.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# Rate limiting store: redis (shared by all api instances) or memory
LIMITER_STORE=redis

#--------------------------------------------------------------------
# CORS_ORIGIN=http://localhost:5173,http://localhost:5174
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
LIMITER_STORE=redis