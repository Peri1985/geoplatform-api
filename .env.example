# Copy to .env and adjust. Used by docker-compose.yml.

# PostGIS
POSTGRES_DB=geoplatform
POSTGRES_USER=geoplatform
POSTGRES_PASSWORD=geoplatform
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Nominatim (OSM extract from https://download.geofabrik.de)
NOMINATIM_PBF_URL=https://download.geofabrik.de/europe/greece-latest.osm.pbf
NOMINATIM_REPLICATION_URL=https://download.geofabrik.de/europe/greece-updates/
NOMINATIM_PASSWORD=nominatim
NOMINATIM_IMPORT_WIKIPEDIA=false
NOMINATIM_PORT=8080

# Photon (imports its index from Nominatim)
PHOTON_LANGUAGES=el,en
PHOTON_PORT=2322
